// Home, Updates, System Health and the launcher pages.

import { ListView, TabWidget, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme, Tr, Tile, Title, Muted, PrimaryButton, SecondaryButton, Check, Card, Bar, HeaderCell } from "widgets.slint";
import { App, UpdateRow, HealthRow } from "state.slint";

export component TileGrid inherits Rectangle {
    in property <[{kind: string, text: string, page: string, badge: int}]> tiles;
    property <int> columns: max(1, min(3, floor((root.width - 24px) / 168px)));
    for tile[index] in root.tiles: Tile {
        x: 12px + mod(index, root.columns) * 168px;
        y: 8px + floor(index / root.columns) * 130px;
        kind: tile.kind;
        text: tile.text;
        badge: tile.badge;
        enabled: !App.busy;
        clicked => {
            App.navigate(tile.page);
        }
    }
}

export component HomePage inherits VerticalLayout {
    spacing: 4px;
    Title {
        text: App.home-status;
    }
    Muted {
        text: App.home-detail;
    }
    TileGrid {
        vertical-stretch: 1;
        tiles: App.show-major ? [
            { kind: "updates", text: Tr.t("tile_updates"), page: "updates", badge: App.updates-badge },
            { kind: "refresh", text: Tr.t("tile_check"), page: "check", badge: 0 },
            { kind: "health", text: Tr.t("nav_health"), page: "health", badge: App.health-badge },
            { kind: "major", text: Tr.t("tile_major"), page: "major", badge: 0 },
            { kind: "cleaner", text: Tr.t("tile_cleaner"), page: "cleaner", badge: 0 },
            { kind: "kernel", text: Tr.t("tile_kernels"), page: "kernels", badge: 0 },
            { kind: "sources", text: Tr.t("nav_sources"), page: "sources", badge: 0 },
            { kind: "settings", text: Tr.t("tile_settings"), page: "prefs", badge: 0 },
        ] : [
            { kind: "updates", text: Tr.t("tile_updates"), page: "updates", badge: App.updates-badge },
            { kind: "refresh", text: Tr.t("tile_check"), page: "check", badge: 0 },
            { kind: "health", text: Tr.t("nav_health"), page: "health", badge: App.health-badge },
            { kind: "cleaner", text: Tr.t("tile_cleaner"), page: "cleaner", badge: 0 },
            { kind: "kernel", text: Tr.t("tile_kernels"), page: "kernels", badge: 0 },
            { kind: "sources", text: Tr.t("nav_sources"), page: "sources", badge: 0 },
            { kind: "settings", text: Tr.t("tile_settings"), page: "prefs", badge: 0 },
        ];
    }
}

export component TilesPage inherits VerticalLayout {
    in property <string> title;
    in property <string> intro;
    in property <[{kind: string, text: string, page: string, badge: int}]> tiles;
    spacing: 4px;
    Title {
        text: root.title;
    }
    Muted {
        text: root.intro;
    }
    TileGrid {
        vertical-stretch: 1;
        tiles: root.tiles;
    }
}

component UpdateLine inherits Rectangle {
    in property <UpdateRow> data;
    in property <bool> current;
    in property <bool> odd;
    in property <bool> show-progress;
    callback toggled;
    callback picked;
    height: 26px;
    background: current ? Theme.selected : odd ? #FAFBFA : white;
    TouchArea {
        clicked => {
            root.picked();
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Check {
            y: (parent.height - self.height) / 2;
            checked: root.data.checked;
            enabled: !App.busy;
            toggled => {
                root.toggled();
            }
        }
        Text {
            width: 76px;
            text: root.data.type-label;
            color: root.data.color;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 10px;
            Text {
                text: root.data.title;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                min-width: 60px;
            }
            Text {
                text: root.data.summary;
                color: Theme.muted;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        Text {
            width: 128px;
            text: root.data.version;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 66px;
            text: root.data.size;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        if root.show-progress: Rectangle {
            width: 110px;
            if root.data.progress >= 0: Bar {
                width: parent.width;
                y: (parent.height - self.height) / 2;
                value: root.data.progress;
                label: root.data.progress-text;
            }
        }
    }
}

export component UpdatesPage inherits VerticalLayout {
    spacing: 6px;
    HorizontalLayout {
        spacing: 6px;
        Title {
            text: App.status-title;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
            horizontal-stretch: 1;
        }
        SecondaryButton {
            text: Tr.t("tb_refresh");
            icon: "refresh";
            enabled: !App.busy;
            clicked => {
                App.check-updates();
            }
        }
        PrimaryButton {
            text: Tr.t("install");
            enabled: App.can-install && !App.busy;
            clicked => {
                App.install();
            }
        }
    }
    Card {
        vertical-stretch: 3;
        min-height: 120px;
        clip: true;
        VerticalLayout {
            padding: 1px;
            Rectangle {
                height: 26px;
                border-width: 0px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    Check {
                        y: (parent.height - self.height) / 2;
                        checked: App.all-checked;
                        enabled: !App.busy && App.updates.length > 0;
                        toggled => {
                            App.select-all(self.checked);
                        }
                    }
                    HeaderCell {
                        width: 76px;
                        text: Tr.t("col_type");
                    }
                    HeaderCell {
                        horizontal-stretch: 1;
                        text: Tr.t("col_update");
                    }
                    HeaderCell {
                        width: 128px;
                        text: Tr.t("new");
                    }
                    HeaderCell {
                        width: 66px;
                        text: Tr.t("size");
                        horizontal-alignment: right;
                    }
                    if App.show-progress: HeaderCell {
                        width: 110px;
                        text: Tr.t("progress");
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }
            }
            ListView {
                for row[index] in App.updates: ContextMenuArea {
                    height: 26px;
                    enabled: !App.busy;
                    Menu {
                        MenuItem {
                            title: Tr.t("mm_select_all");
                            activated => {
                                App.select-all(true);
                            }
                        }
                        MenuItem {
                            title: Tr.t("mm_clear");
                            activated => {
                                App.select-all(false);
                            }
                        }
                        MenuItem {
                            title: Tr.t("mm_select_security");
                            activated => {
                                App.select-security();
                            }
                        }
                        MenuSeparator {}
                        if row.apt: MenuItem {
                            title: Tr.t("cm_ignore_version_short");
                            activated => {
                                App.ignore(index, true);
                            }
                        }
                        if row.apt: MenuItem {
                            title: Tr.t("cm_ignore_all");
                            activated => {
                                App.ignore(index, false);
                            }
                        }
                        MenuItem {
                            title: Tr.t("cm_select_same");
                            activated => {
                                App.select-category(index);
                            }
                        }
                    }
                    UpdateLine {
                        data: row;
                        odd: mod(index, 2) == 1;
                        current: index == App.current-update;
                        show-progress: App.show-progress;
                        toggled => {
                            App.toggle-update(index);
                        }
                        picked => {
                            App.current-update = index;
                            App.current-changed(index);
                        }
                    }
                }
            }
        }
    }
    details := TabWidget {
        vertical-stretch: 1;
        min-height: 120px;
        current-index <=> App.details-tab;
        Tab {
            title: Tr.t("tab_description");
            ScrollView {
                VerticalLayout {
                    padding: 8px;
                    spacing: 3px;
                    alignment: start;
                    if App.d-name == "": Muted {
                        text: Tr.t("choose");
                    }
                    if App.d-name != "": HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Text {
                            text: App.d-name;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: App.d-type;
                            font-weight: 600;
                            color: App.d-color;
                        }
                        Text {
                            text: App.d-meta;
                            color: Theme.muted;
                            overflow: elide;
                        }
                    }
                    if App.d-name != "": Text {
                        text: App.d-text;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    if App.d-name != "": Text {
                        text: App.d-advice;
                        color: #4B5563;
                        wrap: word-wrap;
                    }
                }
            }
        }
        Tab {
            title: Tr.t("tab_packages");
            TextEdit {
                read-only: true;
                text: App.packages-text;
                font-size: Theme.font-small;
                wrap: no-wrap;
            }
        }
        Tab {
            title: Tr.t("tab_changelog");
            TextEdit {
                read-only: true;
                text: App.changelog-text;
                font-size: Theme.font-small;
                wrap: no-wrap;
            }
        }
        changed current-index => {
            App.details-changed(self.current-index);
        }
    }
}

component HealthLine inherits Rectangle {
    in property <HealthRow> data;
    callback toggled;
    callback open;
    height: root.data.header ? 28px : 40px;
    background: white;
    if root.data.header: Text {
        x: 8px;
        text: root.data.title;
        font-weight: 700;
        color: Theme.text;
        vertical-alignment: center;
    }
    if !root.data.header: HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 8px;
        if root.data.checkable: Check {
            y: (parent.height - self.height) / 2;
            checked: root.data.checked;
            enabled: !App.busy;
            toggled => {
                root.toggled();
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.data.title;
                color: root.data.ok ? #0F7B4F : Theme.text;
                font-weight: root.data.ok ? 700 : 400;
                overflow: elide;
            }
            if root.data.detail != "": Text {
                text: root.data.detail;
                color: Theme.muted;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }
        Text {
            text: root.data.label;
            color: root.data.color;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #F1F3F2;
    }
    if !root.data.header && root.data.page != "": TouchArea {
        mouse-cursor: pointer;
        x: 30px;
        width: parent.width - 30px;
        double-clicked => {
            root.open();
        }
    }
}

export component HealthPage inherits VerticalLayout {
    spacing: 6px;
    HorizontalLayout {
        spacing: 6px;
        VerticalLayout {
            horizontal-stretch: 1;
            Title {
                text: Tr.t("nav_health");
            }
            Muted {
                text: App.health-scanning ? Tr.t("hp_scanning") : App.health-summary;
            }
        }
        VerticalLayout {
            alignment: center;
            SecondaryButton {
            text: Tr.t("hp_scan");
            enabled: !App.busy && !App.health-scanning;
            clicked => {
                App.scan-health();
            }
        }
        }
        VerticalLayout {
            alignment: center;
            PrimaryButton {
                text: Tr.t("hp_fix");
                enabled: App.can-fix-health && !App.busy;
                clicked => {
                    App.fix-health();
                }
            }
        }
    }
    Card {
        vertical-stretch: 1;
        clip: true;
        ListView {
            for row[index] in App.health: HealthLine {
                data: row;
                toggled => {
                    App.toggle-health(index);
                }
                open => {
                    App.open-health(index);
                }
            }
        }
    }
}
